// Prisma Schema for NovaTrix ISO 27001 Audit Management System
// Database: SQLite

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Users Table (Mock Authentication)
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         String   @default("auditor")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  uploadedDocuments Document[]
  annotations       Annotation[]
  interviews        Interview[]    @relation("interviewer")
  createdQuestions  Question[]
  activities        Activity[]
  declarations      Declaration[]

  @@map("users")
}

// Documents Table
model Document {
  id                   Int      @id @default(autoincrement())
  title                String
  slug                 String   @unique
  filePath             String   @map("file_path")
  fileType             String   @default("PDF") @map("file_type")
  fileSize             String?  @map("file_size")
  uploadDate           DateTime @default(now()) @map("upload_date")
  status               String   @default("raw") // raw, analyzed, verified
  uploadedById         Int?     @map("uploaded_by")
  summaryShort         String?  @map("summary_short")
  summaryDetailed      String?  @map("summary_detailed")
  summaryIsoCompliance String?  @map("summary_iso_compliance")
  readPercentage       Float    @default(0.0) @map("read_percentage")
  gapCount             Int      @default(0) @map("gap_count")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  // Relations
  uploadedBy    User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  annotations   Annotation[]
  gaps          Gap[]
  evidenceItems EvidenceItem[]

  @@map("documents")
}

// Annex A Controls Table (ISO 27001:2022)
model AnnexAControl {
  id               String    @id // A.5.1, A.6.3, etc.
  category         String // ORGANIZATIONAL, PEOPLE, PHYSICAL, TECHNOLOGICAL
  title            String
  description      String
  status           String    @default("pending") // compliant, partial, non-compliant, pending
  rating           Int       @default(0) // 0-100
  explanation      String?
  baselineMaturity String?   @default("not-assessed") @map("baseline_maturity") // not-assessed, initial, managed, defined, measured, optimized
  baselineNotes    String?   @map("baseline_notes") // Initial assessment notes
  assessmentDate   DateTime? @map("assessment_date")
  assessedBy       Int?      @map("assessed_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  suggestedActions     ControlSuggestedAction[]
  annotationControls   AnnotationControl[]
  gaps                 Gap[]
  soaEntry             SOAEntry?
  interviewQAControls  InterviewQAControl[]

  @@map("annex_a_controls")
}

// Suggested Actions for Each Control
model ControlSuggestedAction {
  id         Int      @id @default(autoincrement())
  controlId  String   @map("control_id")
  actionText String   @map("action_text")
  priority   String   @default("medium") // low, medium, high
  status     String   @default("pending") // pending, in-progress, completed
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  control AnnexAControl @relation(fields: [controlId], references: [id], onDelete: Cascade)

  @@map("control_suggested_actions")
}

// Annotations/Pinpoints Table (PDF Highlights)
model Annotation {
  id              Int      @id @default(autoincrement())
  documentId      Int      @map("document_id")
  paragraphId     String?  @map("paragraph_id") // for URL anchoring
  positionData    String   @map("position_data") // JSON: {boundingRect, rects, pageNumber}
  highlightedText String   @map("highlighted_text")
  annotationText  String?  @map("annotation_text")
  color           String   @default("#ffeb3b")
  createdById     Int?     @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  document           Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy          User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  annotationControls AnnotationControl[]

  @@map("annotations")
}

// Junction Table: Annotations ↔ Annex A Controls
model AnnotationControl {
  id           Int      @id @default(autoincrement())
  annotationId Int      @map("annotation_id")
  controlId    String   @map("control_id")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  annotation Annotation    @relation(fields: [annotationId], references: [id], onDelete: Cascade)
  control    AnnexAControl @relation(fields: [controlId], references: [id], onDelete: Cascade)

  @@unique([annotationId, controlId])
  @@map("annotation_controls")
}

// Gap Analysis Table
model Gap {
  id          Int      @id @default(autoincrement())
  documentId  Int?     @map("document_id")
  controlId   String?  @map("control_id")
  gapType     String   @map("gap_type") // missing, weakness, recommendation
  description String
  severity    String   @default("medium") // low, medium, high, critical
  status      String   @default("open") // open, acknowledged, in-progress, resolved
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  document Document?      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  control  AnnexAControl? @relation(fields: [controlId], references: [id], onDelete: SetNull)

  @@map("gaps")
}

// Respondents Table (Interview Subjects)
model Respondent {
  id        Int      @id @default(autoincrement())
  name      String
  role      String
  division  String?
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  interviews Interview[]

  @@map("respondents")
}

// Questions Bank (Prepared Before Interviews)
model Question {
  id               Int      @id @default(autoincrement())
  questionText     String   @map("question_text")
  questionCategory String?  @map("question_category") // Policy, Technical, Process
  targetControls   String?  @map("target_controls") // JSON: ["A.5.1", "A.6.3"]
  createdById      Int?     @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  interviewQA InterviewQA[]

  @@map("questions")
}

// Interviews Table
model Interview {
  id                 Int      @id @default(autoincrement())
  respondentId       Int      @map("respondent_id")
  interviewDate      DateTime @map("interview_date")
  interviewerId      Int?     @map("interviewer_id")
  status             String   @default("scheduled") // scheduled, completed, analyzed
  aiSummary          String?  @map("ai_summary")
  aiKeyStatements    String?  @map("ai_key_statements") // JSON array
  aiContradictions   String?  @map("ai_contradictions") // JSON array
  aiMaturityScore    Float?   @map("ai_maturity_score") // 0.0 to 5.0
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  respondent  Respondent    @relation(fields: [respondentId], references: [id], onDelete: Cascade)
  interviewer User?         @relation("interviewer", fields: [interviewerId], references: [id], onDelete: SetNull)
  interviewQA InterviewQA[]

  @@map("interviews")
}

// Interview Questions & Answers
model InterviewQA {
  id            Int      @id @default(autoincrement())
  interviewId   Int      @map("interview_id")
  questionId    Int?     @map("question_id") // NULL if ad-hoc question
  questionText  String   @map("question_text")
  answerText    String?  @map("answer_text")
  questionOrder Int      @default(0) @map("question_order")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  interview            Interview            @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question             Question?            @relation(fields: [questionId], references: [id], onDelete: SetNull)
  interviewQAControls  InterviewQAControl[]

  @@map("interview_qa")
}

// Junction Table: Interview QA ↔ Controls
model InterviewQAControl {
  id        Int      @id @default(autoincrement())
  qaId      Int      @map("qa_id")
  controlId String   @map("control_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  qa      InterviewQA   @relation(fields: [qaId], references: [id], onDelete: Cascade)
  control AnnexAControl @relation(fields: [controlId], references: [id], onDelete: Cascade)

  @@unique([qaId, controlId])
  @@map("interview_qa_controls")
}

// SOA (Statement of Applicability)
model SOAEntry {
  id                   Int       @id @default(autoincrement())
  controlId            String    @unique @map("control_id")
  applicability        String // applicable, not-applicable, not-determined
  justification        String?
  implementationStatus String?   @map("implementation_status") // implemented, partially-implemented, not-implemented, planned
  implementationMethod String?   @map("implementation_method") // Manual description of implementation
  responsibleParty     String?   @map("responsible_party")
  targetDate           DateTime? @map("target_date")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relations
  control AnnexAControl @relation(fields: [controlId], references: [id], onDelete: Cascade)

  @@map("soa_entries")
}

// Activity Log (Audit Trail)
model Activity {
  id           Int      @id @default(autoincrement())
  userId       Int?     @map("user_id")
  activityType String   @map("activity_type") // document_uploaded, annotation_created, etc.
  entityType   String?  @map("entity_type") // documents, interviews, controls
  entityId     Int?     @map("entity_id")
  description  String
  metadata     String? // JSON for additional context
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activities")
}

// PHASE 0: PREPARATION MODELS

// Declaration Table (Formal ISMS Declaration)
model Declaration {
  id                   Int       @id @default(autoincrement())
  organizationName     String    @map("organization_name")
  scopeDescription     String    @map("scope_description") // What's included in ISMS scope
  scopeExclusions      String?   @map("scope_exclusions") // What's excluded
  ismsPolicy           String?   @map("isms_policy") // Text or file path
  objectivesStatement  String?   @map("objectives_statement") // Security objectives
  leadershipCommitment String?   @map("leadership_commitment") // Top management commitment
  createdBy            Int?      @map("created_by")
  approvedBy           Int?      @map("approved_by")
  approvalDate         DateTime? @map("approval_date")
  status               String    @default("draft") // draft, submitted, approved
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relations
  creator User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("declarations")
}

// Evidence Item Table (Pre-assessment checklist)
model EvidenceItem {
  id            Int       @id @default(autoincrement())
  category      String // Organization, Policies, Technical, Physical, HR, Infrastructure
  itemName      String    @map("item_name")
  description   String // What this evidence proves
  required      Boolean   @default(true)
  status        String    @default("missing") // missing, collected, verified
  filePath      String?   @map("file_path") // Link to uploaded file
  documentId    Int?      @map("document_id") // Link to Document table if uploaded
  notes         String?
  collectedBy   Int?      @map("collected_by")
  collectedDate DateTime? @map("collected_date")
  verifiedBy    Int?      @map("verified_by")
  verifiedDate  DateTime? @map("verified_date")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@map("evidence_items")
}
